@startuml
left to right direction
skinparam dpi 300
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontSize 11
skinparam nodesep 18
skinparam ranksep 25

title Tratamiento de la base de datos de WordPress

rectangle "<b>Volcado SQL</b>\n---\n• wp_posts\n• wp_postmeta\n• wp_terms\n• wp_term_taxonomy\n• wp_term_relationships" as sql

package "Transformaciones (en orden)" {
  rectangle "<b>1. Filtrado</b>\npost + publish\n(3.622 notas)" as p1
  rectangle "<b>2. Limpieza</b>\nHTML, Gutenberg,\nshortcodes, entidades" as p2
  rectangle "<b>3. Unificación</b>\nslug -> URL\ntaxonomías + IDs -> nombres" as p3
  rectangle "<b>4. Control</b>\n[EMAIL_REDACTED]\n+ 10 chequeos" as p4
}

rectangle "<b>Dataset base</b>\n---\nposteos_anfibia.csv\n(3.622 filas)" as out

sql --> p1
p1 --> p2
p2 --> p3
p3 --> p4
p4 --> out

@enduml
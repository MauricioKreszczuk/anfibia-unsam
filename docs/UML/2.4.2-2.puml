
@startuml 2.4.2-2

skinparam dpi 300
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11

legend right
  <b>Glosario</b>
  ----
  <b>Similitud léxica</b>
  Coincidencia de letras
  entre etiquetas (0 a 1).

  <b>Diacríticos / #</b>
  Diferencias solo de tildes
  o signo numeral.

  <b>Lema</b>
  Raíz gramatical
  (ej. plural → singular).

  <b>Embeddings</b>
  Vectores que representan
  el significado.

  <b>Similitud semántica</b>
  Cercanía de significado
  entre vectores (0 a 1).
endlegend

@enduml

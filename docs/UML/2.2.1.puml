@startuml 2.2.1
left to right direction
skinparam dpi 300
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontSize 11
skinparam nodesep 18
skinparam ranksep 25

title Creación de Tópicos (BERTopic)

rectangle "<b>Embeddings</b>\n---\n3.556 artículos × 384D\n(MiniLM-L12-v2 sobre texto\nsin lematizar)" as emb

rectangle "<b>UMAP</b>\n---\n• Agrupa cada artículo con\n  sus 15 más parecidos\n• Comprime de 384D a 5D" as umap

rectangle "<b>HDBSCAN</b>\n---\n• Detecta zonas densas\n  (mín. 3 notas cercanas)\n• Exige al menos 10 notas\n  para crear un tópico" as hdb

package "Salida" {
  rectangle "<b>Outliers (Tópico -1)</b>\nNotas dispersas que no alcanzan\ndensidad suficiente para formar tópico" as out
  rectangle "<b>Tópicos base (0..N)</b>\nNúcleos temáticos alrededor de los cuales\nse concentran los artículos" as ok
}

emb --> umap
umap --> hdb
hdb --> ok
hdb --> out

@enduml
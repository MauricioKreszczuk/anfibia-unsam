# Entorno virtual
venv/
env/
.env/

# Datos crudos y procesados (se preserva la estructura)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Salidas pesadas
outputs/*
!outputs/.gitkeep

# Formatos de datos por extensión
*.csv
*.parquet
*.json
*.sql
*.sqlite
*.db

# Archivos temporales y notebooks de prueba
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/